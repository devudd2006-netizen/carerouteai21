# CareRoute AI — environment configuration (copy to .env or set in your shell)
# NEVER commit real secrets. All keys are optional: the platform degrades honestly.

# --- AI (summaries: Health Memory, Clinical Snapshot, emergency voice script) ---
# Gemini is the documented provider; a generic OpenAI-compatible endpoint also works.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# Or, for an OpenAI-compatible provider instead of Gemini:
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- Maps / Places (dynamic hospital discovery for ANY location) ---
# Without a key, discovery runs on the verified prototype directory — same workflow.
GOOGLE_MAPS_API_KEY=

# --- Database ---
# SQLite (prototype default): file path relative to the backend/ directory.
DATABASE_URL=sqlite:///./careroute.db
# PostgreSQL (production): postgresql+psycopg://user:password@host:5432/careroute

# --- Auth ---
# JWT signing secret. REQUIRED in production; generated per-boot in dev if unset.
AUTH_SECRET=

# Public medical-camp discovery through Google Places when GOOGLE_MAPS_API_KEY is configured
MEDICAL_CAMPS_LIVE=1
